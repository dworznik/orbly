{
  // Cloudflare Workers Builds config.
  //
  // No build step: the repo root IS the asset directory. The Worker exists only
  // to serve /config.js from the environment, so that no Loops form id is ever
  // committed — set LOOPS_FORM_ID in the dashboard, per environment.
  //
  // There is deliberately no static config.js: Workers serves a matching asset
  // in preference to the Worker, so a committed file would shadow the dynamic
  // one and silently reintroduce a hardcoded id.
  //
  // `name` must match the Worker this repo is connected to in the dashboard.
  "name": "orbly",
  "compatibility_date": "2026-09-08",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
